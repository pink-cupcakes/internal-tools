# Copy to .env and supply your own key. Never commit the real .env file.
OPENAI_API_KEY=sk-************

# Langfuse project keys (Project Settings > API Keys). Used by --send --env-file .env.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ClickHouse Cloud API key pair (console > API Keys). For provisioning; not database login.
CLICKHOUSE_API_KEY_ID=
CLICKHOUSE_API_KEY_SECRET=
